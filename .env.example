# ─────────────────────────────────────────────────────────────────────────────
# OneNOnly — environment variables
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL (required)
# Pooler URL for the app runtime; DIRECT_DATABASE_URL for migrations/DDL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Admin bootstrap (required for first login only)
# Used ONCE to claim the first admin account at /admin.
# After the admin exists, remove this var from production.
ADMIN_PASSWORD=change-me-before-first-login

# Session signing secret (required) — generate: openssl rand -hex 32
ADMIN_SECRET=generate-a-64-char-random-hex

# Public site URL (recommended in production — powers sitemap.xml + SEO/OG)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email verification mailer (optional — no mail sent while unset; the
# verification link is logged to the server console instead)
# MAIL_FROM="One N Only <no-reply@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
